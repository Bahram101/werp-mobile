{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SERVER_URL": "https://api-test.aura-it.kz:9443"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },

    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "SERVER_URL": "https://api.aura-it.kz"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "cache": {
        "disabled": false,
        "key": "prod-cache-v1",
        "paths": ["node_modules", ".gradle", ".pnpm-store", "yarn.lock"]
      }
    }
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
